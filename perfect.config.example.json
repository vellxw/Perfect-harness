{
  "version": 1,
  "agents": {
    "planner": {
      "id": "planner",
      "provider": "xai",
      "accountRef": "xai-personal",
      "model": "grok-4.6",
      "reasoning": "xhigh",
      "auth": "oauth",
      "billingMode": "subscription",
      "capabilities": ["text", "image", "tools"],
      "readOnly": true
    },
    "general": {
      "id": "general",
      "provider": "xai",
      "accountRef": "xai-personal",
      "model": "grok-4.6",
      "reasoning": "medium",
      "auth": "oauth",
      "billingMode": "subscription",
      "capabilities": ["text", "image", "tools"],
      "readOnly": false
    },
    "frontend": {
      "id": "frontend",
      "provider": "opencode",
      "accountRef": "opencode-personal",
      "model": "muse-spark-1.3-contributor-free",
      "reasoning": "xhigh",
      "auth": "api_key",
      "billingMode": "free",
      "capabilities": ["text", "image", "tools"],
      "readOnly": false
    },
    "backend": {
      "id": "backend",
      "provider": "openai-codex",
      "accountRef": "chatgpt-personal",
      "model": "gpt-6-astra",
      "reasoning": "high",
      "auth": "oauth",
      "billingMode": "subscription",
      "capabilities": ["text", "image", "tools"],
      "readOnly": false
    },
    "oracle": {
      "id": "oracle",
      "provider": "openai-codex",
      "accountRef": "chatgpt-personal",
      "model": "gpt-6-astra",
      "reasoning": "xhigh",
      "auth": "oauth",
      "billingMode": "subscription",
      "capabilities": ["text", "image", "tools"],
      "readOnly": true
    },
    "integrator": {
      "id": "integrator",
      "provider": "xai",
      "accountRef": "xai-personal",
      "model": "grok-4.6",
      "reasoning": "medium",
      "auth": "oauth",
      "billingMode": "subscription",
      "capabilities": ["text", "image", "tools"],
      "readOnly": false
    },
    "visual": {
      "id": "visual",
      "provider": "xai",
      "accountRef": "xai-personal",
      "model": "grok-4.6",
      "reasoning": "medium",
      "auth": "oauth",
      "billingMode": "subscription",
      "capabilities": ["text", "image", "tools"],
      "readOnly": true
    }
  },
  "limits": {
    "maxGoalIterations": 10,
    "maxTaskRetries": 2,
    "maxSameFailureRetries": 1,
    "maxPlannerCalls": 8,
    "maxOracleCalls": 3,
    "maxAgentTurns": 24,
    "maxGoalProviderRequests": 200,
    "timeoutPerTask": 1200000,
    "timeoutPerGoal": 7200000,
    "maxProviderRetries": 2,
    "maxNoProgressIterations": 2,
    "contextTokens": 24000,
    "maxOutputTokens": 12000,
    "maxImageBytes": 10000000,
    "maxReviewImages": 24,
    "maxToolTextChars": 16000,
    "maxFileBytes": 2000000,
    "maxWorkspaceBytes": 100000000
  },
  "parallelism": {
    "maxParallelAgents": 4,
    "maxParallelWriters": 2,
    "maxParallelGeneralWorkers": 2,
    "perAccount": {
      "xai-personal": 2,
      "chatgpt-personal": 1,
      "opencode-personal": 1
    },
    "heavyCommands": 1
  },
  "budgets": { "mode": "warn", "maxTokens": 2000000, "allowMetered": false },
  "reviewPolicy": { "finalFeatureReview": true, "visualReview": true },
  "verificationPolicy": { "extraChecks": [], "requirePlanApproval": true },
  "protectedPaths": [
    ".env",
    ".git",
    ".pi",
    ".perfect",
    ".ssh",
    ".github",
    "perfect.config.json",
    "auth.json",
    "credentials.json",
    "secrets",
    "references",
    "__snapshots__"
  ],
  "sandbox": {
    "image": "node:24-bookworm-slim",
    "browserImage": "mcr.microsoft.com/playwright:v1.63.0-noble",
    "memoryMb": 2048,
    "cpus": 2,
    "pids": 256,
    "network": "none"
  },
  "permissions": {
    "allowApply": false,
    "allowRemoteGit": false,
    "allowedExecutables": ["node", "npm", "npx", "python3", "git", "sh"],
    "researchHosts": []
  }
}
