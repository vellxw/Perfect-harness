{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "default": 1,
      "type": "number",
      "const": 1
    },
    "agents": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "enum": [
          "planner",
          "general",
          "frontend",
          "backend",
          "oracle",
          "integrator",
          "visual"
        ]
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "planner",
              "general",
              "frontend",
              "backend",
              "oracle",
              "integrator",
              "visual"
            ]
          },
          "provider": {
            "type": "string"
          },
          "accountRef": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]+$"
          },
          "model": {
            "type": "string"
          },
          "reasoning": {
            "type": "string",
            "enum": ["off", "minimal", "low", "medium", "high", "xhigh", "max"]
          },
          "auth": {
            "type": "string",
            "enum": ["oauth", "api_key", "mock"]
          },
          "billingMode": {
            "type": "string",
            "enum": ["subscription", "free", "metered", "mock"]
          },
          "capabilities": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": ["text", "image", "tools"]
            }
          },
          "readOnly": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "provider",
          "accountRef",
          "model",
          "reasoning",
          "auth",
          "billingMode",
          "capabilities",
          "readOnly"
        ],
        "additionalProperties": false
      }
    },
    "limits": {
      "type": "object",
      "properties": {
        "maxGoalIterations": {
          "default": 10,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "maxTaskRetries": {
          "default": 2,
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "maxSameFailureRetries": {
          "default": 1,
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "maxPlannerCalls": {
          "default": 8,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "maxOracleCalls": {
          "default": 3,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "maxAgentTurns": {
          "default": 24,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "maxGoalProviderRequests": {
          "default": 200,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "timeoutPerTask": {
          "default": 1200000,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 2147000000
        },
        "timeoutPerGoal": {
          "default": 7200000,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 2147000000
        },
        "maxProviderRetries": {
          "default": 2,
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "maxNoProgressIterations": {
          "default": 2,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "contextTokens": {
          "default": 24000,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "maxOutputTokens": {
          "default": 12000,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "maxFileBytes": {
          "default": 2000000,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "maxWorkspaceBytes": {
          "default": 100000000,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "maxGoalIterations",
        "maxTaskRetries",
        "maxSameFailureRetries",
        "maxPlannerCalls",
        "maxOracleCalls",
        "maxAgentTurns",
        "maxGoalProviderRequests",
        "timeoutPerTask",
        "timeoutPerGoal",
        "maxProviderRetries",
        "maxNoProgressIterations",
        "contextTokens",
        "maxOutputTokens",
        "maxFileBytes",
        "maxWorkspaceBytes"
      ],
      "additionalProperties": false
    },
    "parallelism": {
      "type": "object",
      "properties": {
        "maxParallelAgents": {
          "default": 4,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "maxParallelWriters": {
          "default": 2,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "maxParallelGeneralWorkers": {
          "default": 2,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "perAccount": {
          "default": {
            "xai-personal": 2,
            "chatgpt-personal": 1,
            "opencode-personal": 1
          },
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          }
        },
        "heavyCommands": {
          "default": 1,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "maxParallelAgents",
        "maxParallelWriters",
        "maxParallelGeneralWorkers",
        "perAccount",
        "heavyCommands"
      ],
      "additionalProperties": false
    },
    "budgets": {
      "type": "object",
      "properties": {
        "mode": {
          "default": "warn",
          "type": "string",
          "enum": ["off", "warn", "hard"]
        },
        "maxTokens": {
          "default": 2000000,
          "type": "number",
          "exclusiveMinimum": 0
        },
        "maxCostUsd": {
          "type": "number",
          "minimum": 0
        },
        "allowMetered": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": ["mode", "maxTokens", "allowMetered"],
      "additionalProperties": false
    },
    "reviewPolicy": {
      "type": "object",
      "properties": {
        "finalFeatureReview": {
          "default": true,
          "type": "boolean"
        },
        "visualReview": {
          "default": true,
          "type": "boolean"
        }
      },
      "required": ["finalFeatureReview", "visualReview"],
      "additionalProperties": false
    },
    "verificationPolicy": {
      "type": "object",
      "properties": {
        "extraChecks": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,95}$"
              },
              "title": {
                "type": "string"
              },
              "kind": {
                "type": "string",
                "enum": ["command", "browser", "remotion"]
              },
              "criteriaIds": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,95}$"
                }
              },
              "mandatory": {
                "default": true,
                "type": "boolean"
              },
              "command": {
                "type": "object",
                "properties": {
                  "executable": {
                    "type": "string",
                    "minLength": 1
                  },
                  "args": {
                    "default": [],
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "cwd": {
                    "default": ".",
                    "type": "string"
                  },
                  "timeoutMs": {
                    "default": 120000,
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 1200000
                  }
                },
                "required": ["executable", "args", "cwd", "timeoutMs"],
                "additionalProperties": false
              },
              "scenario": {
                "type": "object",
                "properties": {
                  "path": {
                    "default": "/",
                    "type": "string"
                  },
                  "port": {
                    "default": 3000,
                    "type": "integer",
                    "minimum": 1024,
                    "maximum": 65535
                  },
                  "server": {
                    "type": "object",
                    "properties": {
                      "executable": {
                        "type": "string",
                        "minLength": 1
                      },
                      "args": {
                        "default": [],
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "cwd": {
                        "default": ".",
                        "type": "string"
                      },
                      "timeoutMs": {
                        "default": 120000,
                        "type": "integer",
                        "exclusiveMinimum": 0,
                        "maximum": 1200000
                      }
                    },
                    "required": ["executable", "args", "cwd", "timeoutMs"],
                    "additionalProperties": false
                  },
                  "readyPath": {
                    "default": "/",
                    "type": "string"
                  },
                  "viewports": {
                    "minItems": 1,
                    "maxItems": 8,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "width": {
                          "type": "integer",
                          "minimum": 240,
                          "maximum": 3840
                        },
                        "height": {
                          "type": "integer",
                          "minimum": 240,
                          "maximum": 2160
                        }
                      },
                      "required": ["width", "height"],
                      "additionalProperties": false
                    }
                  },
                  "actions": {
                    "default": [],
                    "type": "array",
                    "items": {
                      "anyOf": [
                        {
                          "type": "object",
                          "properties": {
                            "type": {
                              "type": "string",
                              "const": "click"
                            },
                            "selector": {
                              "type": "string"
                            }
                          },
                          "required": ["type", "selector"],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "type": {
                              "type": "string",
                              "const": "fill"
                            },
                            "selector": {
                              "type": "string"
                            },
                            "value": {
                              "type": "string"
                            }
                          },
                          "required": ["type", "selector", "value"],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "type": {
                              "type": "string",
                              "const": "expectText"
                            },
                            "selector": {
                              "type": "string"
                            },
                            "value": {
                              "type": "string"
                            }
                          },
                          "required": ["type", "selector", "value"],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "type": {
                              "type": "string",
                              "const": "expectVisible"
                            },
                            "selector": {
                              "type": "string"
                            }
                          },
                          "required": ["type", "selector"],
                          "additionalProperties": false
                        }
                      ]
                    }
                  },
                  "targetFiles": {
                    "default": [],
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "maxConsoleErrors": {
                    "default": 0,
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "frames": {
                    "default": [],
                    "type": "array",
                    "items": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    }
                  }
                },
                "required": [
                  "path",
                  "port",
                  "server",
                  "readyPath",
                  "viewports",
                  "actions",
                  "targetFiles",
                  "maxConsoleErrors",
                  "frames"
                ],
                "additionalProperties": false
              },
              "remotion": {
                "type": "object",
                "properties": {
                  "composition": {
                    "type": "string"
                  },
                  "entry": {
                    "type": "string"
                  },
                  "frames": {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "fps": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "durationFrames": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  },
                  "width": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "height": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                },
                "required": [
                  "composition",
                  "entry",
                  "frames",
                  "fps",
                  "durationFrames",
                  "width",
                  "height"
                ],
                "additionalProperties": false
              }
            },
            "required": ["id", "title", "kind", "criteriaIds", "mandatory"],
            "additionalProperties": false
          }
        },
        "requirePlanApproval": {
          "default": true,
          "type": "boolean"
        }
      },
      "required": ["extraChecks", "requirePlanApproval"],
      "additionalProperties": false
    },
    "protectedPaths": {
      "default": [
        ".env",
        ".git",
        ".pi",
        ".perfect",
        ".ssh",
        ".github",
        "perfect.config.json",
        "auth.json",
        "credentials.json",
        "secrets",
        "references",
        "__snapshots__"
      ],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sandbox": {
      "type": "object",
      "properties": {
        "image": {
          "default": "node:24-bookworm-slim",
          "type": "string"
        },
        "browserImage": {
          "default": "mcr.microsoft.com/playwright:v1.63.0-noble",
          "type": "string"
        },
        "memoryMb": {
          "default": 2048,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "cpus": {
          "default": 2,
          "type": "number",
          "exclusiveMinimum": 0
        },
        "pids": {
          "default": 256,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "network": {
          "default": "none",
          "type": "string",
          "const": "none"
        }
      },
      "required": [
        "image",
        "browserImage",
        "memoryMb",
        "cpus",
        "pids",
        "network"
      ],
      "additionalProperties": false
    },
    "permissions": {
      "type": "object",
      "properties": {
        "allowApply": {
          "default": false,
          "type": "boolean"
        },
        "allowRemoteGit": {
          "default": false,
          "type": "boolean",
          "const": false
        },
        "allowedExecutables": {
          "default": ["node", "npm", "npx", "python3", "git", "sh"],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "researchHosts": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "allowApply",
        "allowRemoteGit",
        "allowedExecutables",
        "researchHosts"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "version",
    "agents",
    "limits",
    "parallelism",
    "budgets",
    "reviewPolicy",
    "verificationPolicy",
    "protectedPaths",
    "sandbox",
    "permissions"
  ],
  "additionalProperties": false
}
