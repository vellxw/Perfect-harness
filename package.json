{
  "name": "perfect-harness",
  "version": "0.2.1",
  "description": "Evidence-driven coding agents with a reactive glass terminal interface",
  "type": "module",
  "engines": {
    "node": ">=26.4 <27"
  },
  "license": "MIT",
  "private": true,
  "bin": {
    "perfect": "dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./pi-extension": {
      "types": "./dist/pi-extension/index.d.ts",
      "import": "./dist/pi-extension/index.js"
    }
  },
  "files": [
    "dist",
    "docs",
    "examples",
    "assets",
    "perfect.config.example.json",
    "perfect.config.schema.json",
    "README.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "format": "prettier --write src tests docs examples *.json *.md .github/workflows",
    "test": "node --experimental-ffi scripts/test.mjs",
    "test:contract": "node --experimental-ffi scripts/test.mjs contract",
    "test:integration": "node --experimental-ffi scripts/test.mjs integration",
    "test:e2e": "node --experimental-ffi scripts/test.mjs e2e",
    "test:tui": "node --experimental-ffi scripts/test.mjs tui",
    "audit:production": "npm audit --omit=dev --audit-level=high",
    "generate:config": "node --import tsx scripts/generate-config.mjs",
    "check:config": "node --import tsx scripts/generate-config.mjs --check",
    "test:package": "node scripts/package-check.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.85.1",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@opentui/core": "0.5.9",
    "@opentui/react": "0.5.9",
    "ajv": "8.18.0",
    "commander": "14.0.0",
    "playwright": "1.63.0",
    "react": "19.2.0",
    "typebox": "1.3.7",
    "zod": "4.1.5"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "24.3.1",
    "@types/react": "19.2.0",
    "esbuild": "0.25.9",
    "eslint": "9.34.0",
    "prettier": "3.6.2",
    "tsx": "4.20.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.41.0"
  },
  "types": "./dist/index.d.ts"
}
