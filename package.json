{
  "name": "perfect-harness",
  "version": "0.1.0",
  "description": "Evidence-driven local multi-agent orchestration on Pi SDK",
  "type": "module",
  "engines": { "node": ">=24 <25" },
  "license": "MIT",
  "private": true,
  "bin": { "perfect": "dist/cli/index.js" },
  "exports": { ".": "./dist/index.js", "./pi-extension": "./dist/pi-extension/index.js" },
  "files": ["dist", "docs", "examples", "perfect.config.example.json", "README.md", "SECURITY.md"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests scripts",
    "test": "node --import tsx --test --test-concurrency=1 tests/**/*.test.ts",
    "test:contract": "node --import tsx --test tests/contract/*.test.ts",
    "test:integration": "node --import tsx --test --test-concurrency=1 tests/integration/*.test.ts",
    "test:e2e": "node --import tsx --test --test-concurrency=1 tests/e2e/*.test.ts"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@earendil-works/pi-ai": "0.85.1",
    "better-sqlite3": "12.2.0",
    "commander": "14.0.0",
    "playwright": "1.55.0",
    "typebox": "1.3.7",
    "zod": "4.1.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "24.3.1",
    "eslint": "9.34.0",
    "typescript-eslint": "8.41.0",
    "tsx": "4.20.5",
    "typescript": "5.9.3"
  }
}
